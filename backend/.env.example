# RoleSync Environment Variables Template
# Copy to .env and configure your values

# NVIDIA NIM / LLM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Optional OpenAI fallback
OPENAI_API_KEY=

# Security & Secrets
SECRET_KEY=rolesync-dev-insecure-secret-key-change-in-production-12345678
MASTER_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

