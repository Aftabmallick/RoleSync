{
  "manifest_version": 3,
  "name": "RoleSync: AI ATS Tailoring & Automation Assistant",
  "version": "2.0.0",
  "description": "Zero-hallucination real-time ATS optimization, Typst PDF compilation, and form automation.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://boards.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://jobs.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.ashbyhq.com/*",
    "*://jobs.ashbyhq.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.icims.com/*",
    "*://*.taleo.net/*",
    "*://*.workable.com/*",
    "*://*.bamboohr.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.rolesync.io/*"
  ],
  "background": {
    "service_worker": "dist/background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://jobs.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ashbyhq.com/*",
        "*://jobs.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.workable.com/*",
        "*://*.bamboohr.com/*",
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["dist/content/injector.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "dist/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open RoleSync"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 ws://localhost:8000 http://127.0.0.1:8000 ws://127.0.0.1:8000 https://api.rolesync.io wss://api.rolesync.io https://identity.googleapis.com https://*.google.com"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "dist/assets/*",
        "dist/content/isolated.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

